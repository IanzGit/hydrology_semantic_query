CUBE_HOST=127.0.0.1
CUBE_PORT=4000
CUBEJS_DEV_MODE=true

# 默认启用：水文数据库（MySQL）
MODEL_NAME=hydrology_model
CUBEJS_DB_TYPE=mysql
CUBEJS_DB_HOST=127.0.0.1
CUBEJS_DB_PORT=3306
CUBEJS_DB_NAME=hydrology_local
CUBEJS_DB_USER=readonly
CUBEJS_DB_PASS=replace_me

# 备选：水文监测数据库（SQL Server）
# 切换时请完整注释上方 7 项，再取消下方 7 项的注释。
# MODEL_NAME=hydrology_monitor_model
# CUBEJS_DB_TYPE=mssql
# CUBEJS_DB_HOST=127.0.0.1
# CUBEJS_DB_PORT=1433
# CUBEJS_DB_NAME=MainData
# CUBEJS_DB_USER=readonly
# CUBEJS_DB_PASS=replace_me
